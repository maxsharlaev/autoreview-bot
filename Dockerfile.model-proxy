# Model-API egress proxy (M3): holds real model keys; no Docker socket.
FROM python:3.12-slim-bookworm

WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 1000 --shell /usr/sbin/nologin proxy

COPY pyproject.toml README.md ./
COPY app ./app

RUN pip install --no-cache-dir . \
    && chown -R proxy:proxy /app

USER proxy
EXPOSE 8081
CMD ["uvicorn", "app.model_proxy.main:app", "--host", "0.0.0.0", "--port", "8081"]
