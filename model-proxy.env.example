# Secrets for the model-proxy service only (M3).
# Copy to model-proxy.env and restrict permissions (chmod 600 on Unix;
# on Windows: icacls model-proxy.env /inheritance:r /grant:r "%USERNAME%:R").
# Compose mounts this via env_file on model-proxy ONLY — never on worker/launcher.
#
# Default upstream key (optional if every owner has PROXY_OWNER_KEY_ENVS):
OPENAI_API_KEY=
#
# Explicit owner_id -> env var *name* map (JSON). Values of those env vars
# must also appear below (Compose env_file injects them into model-proxy).
# Example for hyphenated + underscored owners with distinct keys:
# PROXY_OWNER_KEY_ENVS={"org-a":"ORG_A_HYPHEN_KEY","org_a":"ORG_A_UNDER_KEY"}
# ORG_A_HYPHEN_KEY=
# ORG_A_UNDER_KEY=
#
# Legacy (owner ids without '-'): PROXY_OWNER_<UPPER>_OPENAI_API_KEY=
# PROXY_OWNER_ACME_OPENAI_API_KEY=
