      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (result) (rate(open_pr_review_review_enqueue_total[5m])) * 60",
          "legendFormat": "{{result}}",
          "refId": "A"
        }
      ]
    },
