    {
      "title": "Consecutive upstream failures",
      "type": "stat",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 35
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "max(model_proxy_consecutive_upstream_failures)",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Last real model success",
      "type": "stat",
      "description": "0 means this process has not observed a completed upstream response below HTTP 400. That is unknown, not healthy.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 35
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "max(model_proxy_last_upstream_success_timestamp_seconds)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeFromNow"
        },
        "overrides": []
      }
    },
    {
      "title": "Worker / API logs (quota, fail, hang)",
      "type": "logs",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 43
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "{service=~\"worker|api|model-proxy\"} |~ \"CODEX_QUOTA|CODEX_AUTH|CODEX_UPSTREAM|failed:|stale|job done|job start|review_finished|worker ready|model_proxy outcome|container review\"",
          "refId": "A"
        }
      ]
    }
