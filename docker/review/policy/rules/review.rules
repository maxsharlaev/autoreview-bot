# autoreview-bot review-agent execpolicy (Codex Starlark).
# Best-effort denylist only: forbid interpreters, package managers, network tools,
# opaque shells, build/test runners, and known bypass prefixes. There are no allow
# rules and Codex has no default-deny for unmatched in-sandbox commands; see SECURITY.md.

prefix_rule(
    pattern = ["rg", "--pre"],
    decision = "forbidden",
    justification = "rg preprocessor hooks are forbidden",
)

prefix_rule(
    pattern = ["rg", "--pre-glob"],
    decision = "forbidden",
    justification = "rg preprocessor hooks are forbidden",
)

prefix_rule(
    pattern = ["git", "-c"],
    decision = "forbidden",
    justification = "git config overrides that can change helpers are forbidden",
)

prefix_rule(
    pattern = ["git", "--config"],
    decision = "forbidden",
    justification = "git config overrides that can change helpers are forbidden",
)

prefix_rule(
    pattern = ["sed", "-e"],
    decision = "forbidden",
    justification = "sed expression forms that can invoke helpers are forbidden",
)

prefix_rule(
    pattern = ["sed", "--expression"],
    decision = "forbidden",
    justification = "sed expression forms that can invoke helpers are forbidden",
)

prefix_rule(
    pattern = ["find"],
    decision = "forbidden",
    justification = "find can run arbitrary commands via -exec/-ok; forbid the binary",
)

prefix_rule(
    pattern = ["python"],
    decision = "forbidden",
    justification = "Do not execute repository or interpreter code",
)

prefix_rule(
    pattern = ["python3"],
    decision = "forbidden",
    justification = "Do not execute repository or interpreter code",
)

prefix_rule(
    pattern = ["node"],
    decision = "forbidden",
    justification = "Do not execute repository or interpreter code",
)

prefix_rule(
