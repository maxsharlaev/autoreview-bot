# Copy to .env and fill in. Never commit real secrets.

POSTGRES_PASSWORD=
# Local Python without Compose: set DATABASE_URL to a matching local PostgreSQL URL.
REDIS_URL=redis://redis:6379/0

GITHUB_APP_ID=0
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# Required: webhook signature verification is mandatory; the service will not start without it.
GITHUB_WEBHOOK_SECRET=change-me
GITHUB_INSTALLATION_ID=0
# Fine-grained PAT (github_pat_...). If set, used instead of GitHub App JWT.
GITHUB_TOKEN=

REVIEW_API_KEY=change-me-review-api-key
WORKER_MAX_JOBS=4
WORKER_JOB_TIMEOUT=900

JIRA_BASE_URL=https://example.atlassian.net
JIRA_EMAIL=ai-review@example.com
JIRA_API_TOKEN=

SLACK_BOT_TOKEN=
# Codex exec authenticates with CODEX_API_KEY (copied from this value). OPENAI_API_KEY alone is not enough.
OPENAI_API_KEY=

CONFIG_PATH=config.yaml
LOG_LEVEL=INFO
LOG_FORMAT=text
METRICS_PORT=9100
RUN_MIGRATIONS=true
