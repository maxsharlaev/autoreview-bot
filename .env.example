# Copy to .env and fill in. Never commit real secrets.
# Every variable, its default and the service that reads it: docs/ENVIRONMENT.md

# --- Infrastructure ---
POSTGRES_PASSWORD=
# Compose builds DATABASE_URL from POSTGRES_PASSWORD. Local Python without Compose:
# DATABASE_URL=postgresql+asyncpg://review:review@localhost:5432/review
REDIS_URL=redis://redis:6379/0
CONFIG_PATH=config.yaml
# OPEN_PR_REVIEW_DATA_DIR=   # extra directory for prompts/ and schemas/
# OPEN_PR_REVIEW_SERVICE is set by Compose (api / worker).

# --- Service API ---
# Operator key for /api/v1/reviews and /api/v1/ops/status. Generate: openssl rand -hex 32
REVIEW_API_KEY=change-me-review-api-key

# --- GitHub (default owner) ---
GITHUB_APP_ID=0
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_INSTALLATION_ID=0
# Required for the webhook endpoint: a random value of at least 16 characters.
# Generate with: openssl rand -hex 32
# If left as placeholder or empty, the webhook endpoint is disabled (Actions-only mode).
GITHUB_WEBHOOK_SECRET=change-me
# Fine-grained PAT (github_pat_...). If set, used instead of the GitHub App. GITHUB_PAT is an alias.
GITHUB_TOKEN=

# --- Model ---
# Codex exec authenticates with CODEX_API_KEY (copied from this value). OPENAI_API_KEY alone is not enough.
OPENAI_API_KEY=

# --- Jira / Slack (default owner) ---
JIRA_BASE_URL=https://example.atlassian.net
JIRA_EMAIL=ai-review@example.com
JIRA_API_TOKEN=
SLACK_BOT_TOKEN=

# --- Worker and logs ---
WORKER_MAX_JOBS=4
WORKER_JOB_TIMEOUT=900
LOG_LEVEL=INFO
LOG_FORMAT=text
METRICS_PORT=9100

# --- Per-owner secrets (owners: block in config.yaml; docs/MULTI_OWNER.md) ---
# <ID> is the owner id upper-cased with '-' replaced by '_'.
# OWNER_EXAMPLE_ORG_GITHUB_TOKEN=
# OWNER_EXAMPLE_ORG_GITHUB_APP_ID=
# OWNER_EXAMPLE_ORG_GITHUB_APP_PRIVATE_KEY=
# OWNER_EXAMPLE_ORG_GITHUB_WEBHOOK_SECRET=
# OWNER_EXAMPLE_ORG_REVIEW_API_KEY=
# OWNER_EXAMPLE_ORG_JIRA_API_TOKEN=
# OWNER_EXAMPLE_ORG_SLACK_BOT_TOKEN=
# OWNER_EXAMPLE_ORG_OPENAI_API_KEY=

# --- Migrations ---
# Only for downgrading 007_findings_owner_id with conflicting rows (docs/UPGRADE.md):
# MIGRATION_007_DOWNGRADE_DROP_DUPLICATES=1
# RUN_MIGRATIONS is not read by the service; Compose runs migrations in the `migrate` service.

# Opt-in container runner (docker-compose.container-runner.yml)
# LAUNCHER_TOKEN=
# Model-API egress proxy (M3; same overlay). Worker is the issuer; proxy holds model keys.
# PROXY_ISSUER_TOKEN=
# MODEL_PROXY_URL=http://model-proxy:8081
# Optional per-owner upstream keys inside model-proxy (compose override / host env):
# PROXY_OWNER_<ID>_OPENAI_API_KEY=

